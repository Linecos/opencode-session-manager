#include "version.h"

1 ICON "opencode.ico"

1 VERSIONINFO
FILEVERSION OPENCODE_SM_VERSION_MAJOR,OPENCODE_SM_VERSION_MINOR,OPENCODE_SM_VERSION_PATCH,0
PRODUCTVERSION OPENCODE_SM_VERSION_MAJOR,OPENCODE_SM_VERSION_MINOR,OPENCODE_SM_VERSION_PATCH,0
FILEOS 0x00040004L
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "OpenCode Session Manager"
            VALUE "FileDescription", "OpenCode Session Manager"
            VALUE "FileVersion", OPENCODE_SM_VERSION_STRING
            VALUE "InternalName", "opencode-session-manager"
            VALUE "OriginalFilename", "opencode-session-manager.exe"
            VALUE "ProductName", "OpenCode Session Manager"
            VALUE "ProductVersion", OPENCODE_SM_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
